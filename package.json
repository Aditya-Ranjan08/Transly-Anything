{
  "name": "transly",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:client": "npm run dev --workspace frontend",
    "dev:server": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
